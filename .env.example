# ─────────────────────────────────────────────────────────────
# ETTH — Encrypted Traffic Threat Hunter
# Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to '.env' and fill in real values.
# NEVER commit the .env file.

# ── Application ──────────────────────────────────────────────
FLASK_ENV=development
DEBUG=false

# ── API Service (FastAPI) ────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=etth
POSTGRES_USER=etth_user
POSTGRES_PASSWORD=changeme

# ── Redis (Caching / Queue) ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Frontend (React) ─────────────────────────────────────────
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000

# ── Network Analysis Tools ───────────────────────────────────
ZEEK_LOG_DIR=/var/log/zeek
TSHARK_PATH=/usr/bin/tshark
CAPTURE_INTERFACE=eth0

# ── ML Pipeline ──────────────────────────────────────────────
ML_MODEL_DIR=/app/ml/models
ML_DATA_DIR=/app/data

# ── Docker ───────────────────────────────────────────────────
PROJECT_NAME=etth
